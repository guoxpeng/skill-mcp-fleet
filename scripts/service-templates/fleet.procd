#!/bin/sh /etc/rc.common
# MCP Fleet 节点 {{DISPLAY_NAME}}（OpenWrt procd：respawn 自动重启）
# 安装：cp fleet.procd /etc/init.d/{{UNIT_LABEL}} && chmod 755 /etc/init.d/{{UNIT_LABEL}}
#       /etc/init.d/{{UNIT_LABEL}} enable && /etc/init.d/{{UNIT_LABEL}} start
USE_PROCD=1
START=99
STOP=10

start_service() {
    procd_open_instance "mcp-fleet"
    procd_set_param command {{CMD_PYTHON}} -u {{CMD_AGENT}} --host {{HOST}} --port {{PORT}}{{EXTRA_ARGS}}
    # respawn <阈值秒> <重试次数> <重试窗口秒>：崩溃后 5s 重拉，无限次
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file "{{CONFIG_PATH}}"
    procd_set_param limits nofile="4096 4096"
    procd_set_param user "{{SERVICE_USER}}"
    procd_set_param group "{{SERVICE_GROUP}}"
    procd_close_instance
}

stop_service() {
    procd_kill "mcp-fleet" 2>/dev/null
}
