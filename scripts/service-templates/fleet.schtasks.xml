<?xml version="1.0" encoding="UTF-8"?>
<!-- MCP Fleet 节点 {{DISPLAY_NAME}}（Windows 计划任务：登录自启 + 失败重拉）
     注册：schtasks /Create /F /TN "{{TASK_NAME}}" /XML "{{UNIT_PATH}}"
     删除：schtasks /Delete /F /TN "{{TASK_NAME}}" -->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Author>MCP Fleet {{VERSION}}</Author>
    <Description>MCP Fleet 节点 {{DISPLAY_NAME}}（HTTP {{PORT}}）</Description>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
    </LogonTrigger>
    <BootTrigger>
      <Enabled>true</Enabled>
      <Delay>PT30S</Delay>
    </BootTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <RunLevel>HighestAvailable</RunLevel>
      <LogonType>InteractiveToken</LogonType>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Enabled>true</Enabled>
    <Hidden>true</Hidden>
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>999</Count>
    </RestartOnFailure>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>{{CMD_PYTHON_WIN}}</Command>
      <Arguments>-u "{{AGENT_PATH}}" --host {{HOST}} --port {{PORT}}{{EXTRA_ARGS_WIN}}</Arguments>
      <WorkingDirectory>{{INSTALL_DIR}}</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
